DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruitment_v2
APP_ENVIRONMENT=development
TENANT_RLS_MODE=off

# Public URL of the Recruiter web app. Careers API apply_url values point here.
WEB_ORIGIN=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Dushanbe

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=hr-agent-api
JWT_AUDIENCE=hr-agent-web
JWT_EXPIRES_MINUTES=15

# Use an independent random value of at least 32 characters in production.
AUTH_MFA_ENCRYPTION_KEY=
AUTH_MFA_ISSUER=HR Agent
AUTH_MFA_CHALLENGE_MINUTES=5
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_REFRESH_EXPIRES_DAYS=14
# Bounded multi-replica retry window; values above 30 seconds are rejected.
AUTH_REFRESH_RETRY_GRACE_SECONDS=10

# Shared abuse protection for public intake/capability endpoints. The in-memory
# backend is only suitable for tests and one-process development. Production
# requires Valkey over TLS and a dedicated HMAC secret of at least 32 chars.
PUBLIC_RATE_LIMIT_BACKEND=valkey
PUBLIC_RATE_LIMIT_VALKEY_URL=redis://localhost:6379/0
PUBLIC_RATE_LIMIT_HMAC_SECRET=
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Empty means
# the TCP peer address is authoritative and forwarded headers are ignored.
PUBLIC_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
PUBLIC_RATE_LIMIT_READ_REQUESTS=240
PUBLIC_RATE_LIMIT_READ_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MUTATION_REQUESTS=60
PUBLIC_RATE_LIMIT_MUTATION_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_EXPENSIVE_REQUESTS=10
PUBLIC_RATE_LIMIT_EXPENSIVE_WINDOW_SECONDS=600

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_MAX_OUTPUT_TOKENS=4096
LLM_HTTP_TIMEOUT_SECONDS=90
# Provider-routing price ceilings in USD per million tokens.
OPENROUTER_MAX_PROMPT_USD_PER_MILLION=5
OPENROUTER_MAX_COMPLETION_USD_PER_MILLION=20
OPENROUTER_REQUIRE_ZDR=true
# Optional comma-separated approved private/on-prem model origins or hosts.
LLM_PRIVATE_BASE_URL_ALLOWLIST=

# Independent AES-GCM key for connector credentials and sensitive job payloads.
# Generate 32 random bytes and encode them with URL-safe base64; never reuse an
# auth, JWT, database, or provider secret. The key is required in production;
# set a stable key ID when operating a rotation keyring.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=
INTEGRATION_CREDENTIAL_KEY_ID=
# Exact OAuth callback origins. WEB_ORIGIN is always included automatically.
INTEGRATION_OAUTH_REDIRECT_ORIGINS=http://localhost:3000
# Exact public DNS hosts approved for outbound webhooks/provider callbacks.
INTEGRATION_OUTBOUND_HOST_ALLOWLIST=
INTEGRATION_HTTP_TIMEOUT_SECONDS=15
# hh.ru requires a truthful application identifier and operator contact.
HH_USER_AGENT=HR-Agent-Pilot/1.0 (operator@example.com)

# Optional. Without it, GitHub reads use the unauthenticated 60 req/hr limit.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

STORAGE_DIR=./storage
# Local is development/test-only. Production startup requires S3 plus HTTPS;
# the path-style AWS SigV4 adapter is tested against MinIO.
BLOB_STORE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hr-agent-private
# Must be a different bucket. Only this bucket may receive an anonymous-read
# policy, restricted to the generated `logos/` prefix.
S3_PUBLIC_BUCKET=hr-agent-public
S3_ACCESS_KEY=
# Independent least-privilege object-store credential; never reuse auth keys.
S3_SECRET_KEY=
S3_REGION=us-east-1
# Public/CDN origin whose root contains the `logos/` object prefix.
S3_PUBLIC_BASE_URL=http://localhost:9000/hr-agent-public
S3_TIMEOUT_SECONDS=30
# Production validation requires clamav; signature only detects EICAR/test
# markers for deterministic local development.
MALWARE_SCANNER_BACKEND=signature
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
REQUEST_BODY_MAX_BYTES=16777216
STORAGE_RECONCILIATION_STALE_HOURS=24
STORAGE_RECONCILIATION_SCAN_LIMIT=1000

# Durable communications queue (sandbox works without credentials).
COMMUNICATIONS_WORKER_ENABLED=true
COMMUNICATIONS_WORKER_POLL_SECONDS=5
COMMUNICATIONS_CLAIM_LIMIT=50
COMMUNICATIONS_MAX_BULK_CANDIDATES=100

# Durable connector jobs and signed webhook deliveries.
INTEGRATION_WORKER_ENABLED=true
INTEGRATION_WORKER_POLL_SECONDS=5
INTEGRATION_WORKER_CLAIM_LIMIT=25

# Durable calendar reminder queue; provider OAuth jobs run in the worker fleet.
SCHEDULING_WORKER_ENABLED=true
SCHEDULING_WORKER_POLL_SECONDS=15
SCHEDULING_CLAIM_LIMIT=50

# Durable recruiting workflow rules.
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_WORKER_POLL_SECONDS=15
WORKFLOW_CLAIM_LIMIT=50

# Durable AI Hiring Assistant mission worker. Disabling it leaves the Human
# Platform and its workers fully operational.
AI_WORKER_ENABLED=true
AI_WORKER_POLL_SECONDS=2
AI_WORKER_CLAIM_LIMIT=10
CANDIDATE_PROCESSING_WORKER_ENABLED=true
CANDIDATE_PROCESSING_WORKER_POLL_SECONDS=2
CANDIDATE_PROCESSING_CLAIM_LIMIT=10

# Optional one-release compatibility mount for validated files written before
# BlobStore/PrivateObject. Production leaves legacy deletion work pending unless
# this absolute, owner-controlled directory is mounted in the worker container.
LEGACY_PRIVATE_STORAGE_DIR=

# Required in production so rollout health fails if the worker fleet is stale.
WORKER_READINESS_REQUIRED=false
