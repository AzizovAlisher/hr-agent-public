# Auth.js. Generate independently for production: `openssl rand -base64 48`.
# Production refuses to start with this value empty or weak.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Independent encryption root for API access/refresh and MFA challenge cookies.
# Production refuses to start unless this differs from NEXTAUTH_SECRET and is
# at least 32 random bytes (for example: `openssl rand -base64 48`).
AUTH_SESSION_SECRET=

# Server-side URL used by Next.js to call the FastAPI service. In a container
# network this may be an internal URL such as http://api:8000.
API_BASE_URL=http://localhost:8000

# Browser-visible HTTPS URL of FastAPI. Settings → Integration uses this to
# generate the careers feed and embeddable-widget snippets for company sites.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
